{
  "name": "greenlight-ci",
  "version": "0.1.0",
  "description": "An AI agent that turns red CI green: it reads failing CI logs, reproduces the failure, fixes the code and opens a pull request.",
  "type": "module",
  "license": "MIT",
  "author": "Naingzwehtut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naingzwehtut/greenlight.git"
  },
  "bugs": "https://github.com/Naingzwehtut/greenlight/issues",
  "homepage": "https://github.com/Naingzwehtut/greenlight#readme",
  "keywords": [
    "ci",
    "github-actions",
    "ai-agent",
    "llm",
    "claude",
    "automation",
    "devtools",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "greenlight": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --experimental-strip-types bench/run.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^1.7.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
